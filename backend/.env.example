PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Generate a strong random string e.g. openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/event_management_db"

# SMTP settings used to send email verification OTPs
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com

# Optional one-time bootstrap. Configure all four values using deployment
# secrets; the password is hashed before storage and the Admin must change
# it on first sign-in. Existing Admin accounts are never overwritten.
ADMIN_EMAIL=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_INITIAL_PASSWORD=

# Private storage for vendor PDF documents (not served as static files)
VENDOR_DOCUMENTS_DIR=

# Public storage for event banner images
EVENT_BANNERS_DIR=

# Public base URL of this backend (no trailing slash), used to build asset URLs
# e.g. https://your-backend.vercel.app
BASE_URL=
