PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Generate a strong random string e.g. openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/event_management_db"

# SMTP settings used to send email verification OTPs
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com

# Optional one-time bootstrap. Configure all four values using deployment
# secrets. The app startup and `npm run db:seed` use this configuration;
# existing Platform Admin accounts are never overwritten.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_FIRSTNAME=
PLATFORM_ADMIN_LASTNAME=
PLATFORM_ADMIN_INITIAL_PASSWORD=
