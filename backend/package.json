{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "pretest:phase1": "npm run build",
    "test:phase1": "node --test ../tests/phase-1-workflows.test.cjs ../tests/phase-1-api.test.cjs ../tests/backend-foundation.test.cjs",
    "test:phase1:api": "node --test ../tests/phase-1-api.test.cjs"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "prisma": "^5.22.0",
    "tsc-alias": "1.9.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
