generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ATTENDEE
  VENDOR
  ORGANIZER
  ADMIN
  PLATFORM_ADMIN
  MANAGEMENT
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketTypes {
  GENERAL
  VIP
  STAFF
} 

enum PaymentProvider {
  PAYFAST
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum TypeOfTickets {
  PAID
  FREE
}

enum VendorApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ATTENDEE)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  emailVerification  EmailVerification?
  passwordResetToken PasswordResetToken?
  organizedEvents     Event[]
  bookings            Booking[]
  tickets             Ticket[]
  vendorApplications  VendorApplication[]

  @@map("users")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Event {
  id                String      @id @default(uuid())
  title             String
  description       String
  category          String
  venue             String
  date              DateTime
  capacity          Int
  availableCapacity Int         @map("available_capacity")
  isFree            Boolean     @default(true) @map("is_free")
  price             Decimal?    @db.Decimal(10, 2)
  status            EventStatus @default(DRAFT)
  rejectionReason   String?     @map("rejection_reason")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  organizerId        String              @map("organizer_id")
  organizer          User                @relation(fields: [organizerId], references: [id])
  bookings           Booking[]
  tickets            Ticket[]
  vendorApplications VendorApplication[]

  @@map("events")
}

model Booking {
  id            String        @id @default(uuid())
  ticketType    TicketTypes   @default(GENERAL) @map("ticket_type")
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id])
  attendeeId String   @map("attendee_id")
  attendee   User     @relation(fields: [attendeeId], references: [id])
  ticket     Ticket?
  payment    Payment?

  @@map("bookings")
}

model Ticket {
  id              String       @id @default(uuid())
  referenceNumber String       @unique @map("reference_number")
  type            TypeOfTickets @default(FREE) @map("type_of_ticket")
  status          TicketStatus @default(ACTIVE)
  issuedAt        DateTime     @default(now()) @map("issued_at")

  // Relations
  bookingId String  @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])
  eventId   String  @map("event_id")
  event     Event   @relation(fields: [eventId], references: [id])
  holderId  String  @map("holder_id")
  holder    User    @relation(fields: [holderId], references: [id])

  @@map("tickets")
}

model Payment {
  id                String        @id @default(uuid())
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("ZAR")
  status            PaymentStatus @default(PENDING)
  provider          String
  providerReference String?       @map("provider_reference")
  createdAt         DateTime      @default(now()) @map("created_at")

  // Relations
  bookingId String  @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model VendorApplication {
  id                 String                  @id @default(uuid())
  companyName        String                  @map("company_name")
  registrationNumber String                  @map("registration_number")
  description        String
  status             VendorApplicationStatus @default(PENDING_REVIEW)
  invoiceId          String?                 @map("invoice_id")
  createdAt          DateTime                @default(now()) @map("created_at")

  // Relations
  eventId     String            @map("event_id")
  event       Event             @relation(fields: [eventId], references: [id])
  vendorId    String            @map("vendor_id")
  vendor      User              @relation(fields: [vendorId], references: [id])
  staffMembers VendorStaffMember[]

  @@map("vendor_applications")
}

model VendorStaffMember {
  id           String @id @default(uuid())
  name         String
  email        String
  entryPassId  String @map("entry_pass_id")

  // Relations
  applicationId String            @map("application_id")
  application   VendorApplication @relation(fields: [applicationId], references: [id])

  @@map("vendor_staff_members")
}
