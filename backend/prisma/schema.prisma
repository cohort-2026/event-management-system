generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ATTENDEE
  VENDOR
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  IN_PERSON
  ONLINE
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TicketTypes {
  GENERAL
  VIP
  STAFF
} 

enum PaymentProvider {
  PAYFAST
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum TypeOfTickets {
  PAID
  FREE
}

enum VendorApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VendorProfileStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VendorInvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum ProfileApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ATTENDEE)
  isActive     Boolean  @default(true) @map("is_active")
  emailVerified Boolean  @default(false) @map("email_verified")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  emailVerification  EmailVerification?
  passwordResetToken PasswordResetToken?
  passwordSetupToken PasswordSetupToken?
  organizedEvents     Event[]
  bookings            Booking[]
  tickets             Ticket[]
  vendorApplications  VendorApplication[]
  vendorApplicationDecisions VendorApplication[] @relation("VendorApplicationDecider")
  vendorProfile       VendorProfile?
  vendorDocuments     VendorDocument[]
  auditEvents         AuditLog[] @relation("AuditActor")
  notifications       Notification[] @relation("NotificationRecipient")
  organizationName   String? @map("organization_name")
  organizationEmail String? @map("organization_email")
  organizationRegistrationNumber String? @map("organization_registration_number")
  organizationDescription String? @map("organization_description")
  organization       String?
  phone              String?
  profileApprovalStatus ProfileApprovalStatus @default(PENDING_APPROVAL) @map("profile_approval_status")
  profileRejectionReason String? @map("profile_rejection_reason")

  @@map("users")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  action         String
  affectedUserId String?  @map("affected_user_id")
  outcome        String
  createdAt      DateTime @default(now()) @map("created_at")
  actor          User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String   @map("recipient_id")
  title       String
  message     String
  link        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model PasswordSetupToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @unique @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_setup_tokens")
}

model Event {
  id                String      @id @default(uuid())
  title             String
  description       String
  category          String
  venue             String
  date              DateTime
  startTime         DateTime    @map("start_time")
  endTime           DateTime    @map("end_time")
  eventType         EventType   @default(IN_PERSON) @map("event_type")
  meetingDetails    String?     @map("meeting_details")
  bannerImageUrl    String?     @map("banner_image_url")
  vendorStandsAvailable Int     @default(0) @map("vendor_stands_available")
  capacity          Int
  availableCapacity Int         @map("available_capacity")
  isFree            Boolean     @default(true) @map("is_free")
  price             Decimal?    @db.Decimal(10, 2)
  vendorStandRatePerSqm Decimal @default(0) @map("vendor_stand_rate_per_sqm") @db.Decimal(10, 2)
  status            EventStatus @default(DRAFT)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  organizerId        String              @map("organizer_id")
  organizer          User                @relation(fields: [organizerId], references: [id])
  bookings           Booking[]
  tickets            Ticket[]
  vendorApplications VendorApplication[]
  ticketTypes        EventTicketType[]

  @@map("events")
}

model EventTicketType {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  quantity        Int
  availableQuantity Int    @map("available_quantity")
  createdAt       DateTime @default(now()) @map("created_at")

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([eventId])
  @@map("event_ticket_types")
}

model Booking {
  id            String        @id @default(uuid())
  ticketType    TicketTypes   @default(GENERAL) @map("ticket_type")
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id])
  eventTicketTypeId String? @map("event_ticket_type_id")
  eventTicketType EventTicketType? @relation(fields: [eventTicketTypeId], references: [id], onDelete: SetNull)
  attendeeId String   @map("attendee_id")
  attendee   User     @relation(fields: [attendeeId], references: [id])
  ticket     Ticket?
  payment    Payment?

  @@map("bookings")
}

model Ticket {
  id              String       @id @default(uuid())
  referenceNumber String       @unique @map("reference_number")
  type            TypeOfTickets @default(FREE) @map("type_of_ticket")
  status          TicketStatus @default(ACTIVE)
  issuedAt        DateTime     @default(now()) @map("issued_at")

  // Relations
  bookingId String  @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])
  eventId   String  @map("event_id")
  event     Event   @relation(fields: [eventId], references: [id])
  holderId  String  @map("holder_id")
  holder    User    @relation(fields: [holderId], references: [id])

  @@map("tickets")
}

model Payment {
  id                String        @id @default(uuid())
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("ZAR")
  status            PaymentStatus @default(PENDING)
  provider          String
  providerReference String?       @map("provider_reference")
  createdAt         DateTime      @default(now()) @map("created_at")

  // Relations
  bookingId String  @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model VendorApplication {
  id                 String                  @id @default(uuid())
  companyName        String                  @map("company_name")
  registrationNumber String                  @map("registration_number")
  description        String
  requestedStandType String                  @map("requested_stand_type")
  requestedStandSize String                  @map("requested_stand_size")
  standDescription   String                  @map("stand_description")
  supportingInformation String?               @map("supporting_information")
  standAreaSqm      Decimal                 @default(0) @map("stand_area_sqm") @db.Decimal(10, 2)
  standRatePerSqm   Decimal                 @default(0) @map("stand_rate_per_sqm") @db.Decimal(10, 2)
  quotedAmount      Decimal                 @default(0) @map("quoted_amount") @db.Decimal(14, 2)
  assignedStand      String?                 @map("assigned_stand")
  status             VendorApplicationStatus @default(PENDING_REVIEW)
  decidedById        String?                 @map("decided_by_id")
  decidedAt          DateTime?               @map("decided_at")
  rejectionReason    String?                 @map("rejection_reason")
  invoiceId          String?                 @unique @map("invoice_id")
  createdAt          DateTime                @default(now()) @map("created_at")

  // Relations
  eventId     String            @map("event_id")
  event       Event             @relation(fields: [eventId], references: [id])
  vendorId    String            @map("vendor_id")
  vendor      User              @relation(fields: [vendorId], references: [id])
  decidedBy   User?             @relation("VendorApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  invoice     VendorInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  staffMembers VendorStaffMember[]

  @@index([eventId, status])
  @@map("vendor_applications")
}

model VendorInvoice {
  id            String             @id @default(uuid())
  invoiceNumber String             @unique @map("invoice_number")
  amount        Decimal            @db.Decimal(14, 2)
  currency      String             @default("ZAR")
  status        VendorInvoiceStatus @default(ISSUED)
  issuedAt      DateTime           @default(now()) @map("issued_at")
  dueAt         DateTime           @map("due_at")
  application   VendorApplication?

  @@map("vendor_invoices")
}

model VendorProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique @map("user_id")
  businessName             String   @default("") @map("business_name")
  businessDescription      String   @default("") @map("business_description")
  businessRegistrationNumber String  @default("") @map("business_registration_number")
  contactPerson            String   @default("") @map("contact_person")
  contactEmail             String   @default("") @map("contact_email")
  contactPhone             String   @default("") @map("contact_phone")
  productsServices         String[] @default([]) @map("products_services")
  logoUrl                  String?  @map("logo_url")
  supportingDocumentUrls   String[] @default([]) @map("supporting_document_urls")
  status                   VendorProfileStatus @default(DRAFT)
  rejectionReason          String?  @map("rejection_reason")
  reviewedAt               DateTime? @map("reviewed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendor_profiles")
}

model VendorDocument {
  id           String   @id @default(uuid())
  vendorId     String   @map("vendor_id")
  storageName  String   @unique @map("storage_name")
  originalName String   @map("original_name")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorStaffMember {
  id           String @id @default(uuid())
  name         String
  email        String
  entryPassId  String @map("entry_pass_id")

  // Relations
  applicationId String            @map("application_id")
  application   VendorApplication @relation(fields: [applicationId], references: [id])

  @@map("vendor_staff_members")
}
